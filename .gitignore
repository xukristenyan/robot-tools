# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ipynb_checkpoints/

# Virtual environments (root SDK + per-runtime)
.venv
runtimes/*/.venv
runtimes/*/real/.venv

# Model weights / caches (never commit)
checkpoints/
weights/
*.pt
*.pth
*.ckpt
*.safetensors

# Editor / OS
.vscode/
.idea/
.DS_Store
._*
Thumbs.db
*.swp
*~

# Tooling caches / reports
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Local service profile (the user's own copy of services.example.yaml).
# Leading slash anchors at repo root so examples/services.yaml stays tracked.
/services.yaml

# Local endpoint profile (the user's own copy of endpoints.example.yaml).
/endpoints.yaml

# Local inputs and default outputs used by the example scripts.
/data/
/depth.npy
/sam3_out/
